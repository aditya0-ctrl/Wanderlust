<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing</title>
</head>
<body>

<h1>Edit Listing</h1>

<form action="/listings/<%= listing._id %>?_method=PUT" method="POST">

    <label>Title</label><br>
    <input
        type="text"
        name="listing[title]"
        value="<%= listing.title %>"
        required
    >
    <br><br>

    <label>Description</label><br>
    <textarea name="listing[description]"><%= listing.description %></textarea>
    <br><br>

    <label>Image URL</label><br>
    <input
        type="text"
        name="listing[image][url]"
        value="<%= listing.image.url %>"
    >
    <br><br>

    <label>Image Filename</label><br>
    <input
        type="text"
        name="listing[image][filename]"
        value="<%= listing.image.filename %>"
    >
    <br><br>

    <label>Price</label><br>
    <input
        type="number"
        name="listing[price]"
        value="<%= listing.price %>"
    >
    <br><br>

    <label>Location</label><br>
    <input
        type="text"
        name="listing[location]"
        value="<%= listing.location %>"
    >
    <br><br>

    <label>Country</label><br>
    <input
        type="text"
        name="listing[country]"
        value="<%= listing.country %>"
    >
    <br><br>

    <button>Update Listing</button>

</form>

</body>
</html>