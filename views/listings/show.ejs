<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Listing Details</title>
</head>
<body>

<h2>Listing Details</h2>

<ul>
    <li>Title: <%= listing.title %></li>
    <li>Description: <%= listing.description %></li>
    <li>Price: ₹ <%= listing.price.toLocaleString("en-IN") %></li>
    <li>Location: <%= listing.location %></li>
    <li>Country: <%= listing.country %></li>
</ul>

<img src="<%= listing.image.url %>" alt="Listing Image" width="400">

<br><br>

<a href="/listings/<%= listing._id %>/edit">Edit Listing</a>

<br><br>

<form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
    <button>Delete Listing</button>
</form>

</body>
</html>